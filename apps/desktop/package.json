{
  "name": "dpda-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:sync": "node ../../scripts/verify-game-icons.mjs --sync",
    "assets:verify": "node ../../scripts/verify-game-icons.mjs",
    "test:assets": "node --test ../../tests/game-icons-build.test.mjs",
    "predev": "npm run assets:verify",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "prebuild": "npm run assets:verify",
    "build": "tsc --noEmit && vite build",
    "prepreview": "npm run assets:verify",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test:ui": "node tests/ui-smoke.mjs",
    "format:check": "prettier --check src tests vite.config.ts eslint.config.js",
    "format": "prettier --write src tests vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "fflate": "0.8.3",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
